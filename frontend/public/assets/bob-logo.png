2/brands/isin/{isin}\",\"description\":\"Get brand data using an ISIN code.\",\"href\":\"/reference/brand-api-isin\"},{\"title\":\"Brand API - Crypto symbol\",\"sidebarTitle\":\"by Crypto API\",\"openapi\":\"GET /v2/brands/crypto/{symbol}\",\"description\":\"Get brand data using a crypto symbol.\",\"href\":\"/reference/brand-api-crypto\"}]},{\"group\":\"Logo API\",\"pages\":[{\"title\":\"Overview\",\"description\":\"Instantly add any company logos to your app or website\",\"href\":\"/logo-api/overview\"},{\"title\":\"Parameters\",\"description\":\"Detailed reference of all Logo API parameters\",\"href\":\"/logo-api/parameters\"},{\"title\":\"Logo API Usage Guidelines\",\"sidebarTitle\":\"Usage guidelines\",\"description\":\"Instantly add any company logos to your app or website\",\"href\":\"/logo-api/guidelines\"},{\"title\":\"Rate limits\",\"description\":null,\"href\":\"/logo-api/rate-limits\"}]},{\"group\":\"Brand Search API\",\"pages\":[{\"title\":\"Overview\",\"description\":\"Match brand names to their domain and logo\",\"href\":\"/brand-search-api/overview\"},{\"title\":\"Rate limits\",\"description\":null,\"href\":\"/brand-search-api/rate-limits\"},{\"title\":\"Brand Search API Usage Guidelines\",\"sidebarTitle\":\"Usage guidelines\",\"description\":\"Match brand names to their domain and logo\",\"href\":\"/brand-search-api/guidelines\"},{\"title\":\"Brand Search API\",\"sidebarTitle\":\"API Reference\",\"openapi\":\"GET /v2/search/{name}?c={clientId}\",\"description\":\"Search for brands by name, login to get a clientId\",\"href\":\"/reference/brand-search-api\"}]},{\"group\":\"Transaction API\",\"pages\":[{\"title\":\"Overview\",\"description\":\"Turn payment transactions into merchant data.\",\"href\":\"/transaction-api/overview\"},{\"title\":\"Transaction API\",\"sidebarTitle\":\"API Reference\",\"openapi\":\"POST /v2/brands/transaction\",\"description\":\"Turn payment transactions into merchant data.\",\"href\":\"/reference/transaction-api\"}]},{\"group\":\"Webhooks\",\"pages\":[{\"title\":\"Overview\",\"description\":\"Get notified of changes by receiving events at your webhook URL.\",\"href\":\"/webhooks/overview\"},{\"title\":\"Setup a webhook\",\"description\":\"Start receiving event payloads\",\"href\":\"/webhooks/setup\"},{\"title\":\"Delivery behaviors\",\"description\":\"This section helps you understand different behaviors to expect regarding how Brandfetch sends events to your webhook endpoint.\",\"href\":\"/webhooks/delivery-behaviors\"},{\"title\":\"Best practices\",\"description\":\"Review these best practices to make sure your webhooks remain secure and function well with your integration.\",\"href\":\"/webhooks/best-practices\"},{\"title\":\"Event types\",\"description\":\"Overview of subscribable event types\",\"href\":\"/webhooks/event-types\"}]}]},{\"group\":\"Support\",\"pages\":[{\"title\":\"Getting help\",\"description\":\"Our support team is always available and willing to assist you.\",\"href\":\"/support/getting-help\"},{\"title\":\"Security \u0026 SOC2\",\"description\":\"Our commitment to secure data handling and best-in-class practices.\",\"href\":\"/support/security-soc2\"},{\"title\":\"Report inaccuracies\",\"url\":\"https://brandfetch.com/update?mode=dev\",\"description\":\"Report incorrect or missing brand info.\",\"href\":\"/support/report-inaccuracies\"},{\"title\":\"Terms and Conditions\",\"url\":\"https://brandfetch.com/terms?mode=dev\",\"description\":null,\"href\":\"/support/terms-and-conditions\"},{\"title\":\"Service status\",\"url\":\"https://status.brandfetch.io\",\"description\":\"Check the status of Brandfetch services.\",\"href\":\"/support/service-status\"}]}]},{\"tab\":\"Guides\",\"groups\":[{\"group\":\"Guides\",\"pages\":[{\"title\":\"Overview\",\"description\":null,\"href\":\"/guides/overview\"},{\"title\":\"Using a custom fallback image with Logo API\",\"sidebarTitle\":\"Custom Logo API Fallback\",\"description\":\"Learn how to handle 404s and implement your own fa